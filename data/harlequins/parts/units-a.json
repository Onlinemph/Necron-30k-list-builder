      ],
      "traits": [
        "Xenos",
        "Harlequin",
        "Masque Leader"
      ],
      "specialRules": [
        "Eternal Warrior (1)",
        "Fast (2)",
        "Dodge (2+)",
        "The Great Dance",
        "Lord of the Masque",
        "The Endless Encore"
      ],
      "unitRules": [
        {
          "name": "Lord of the Masque",
          "text": "Once per Player Turn, when the Controlling Player declares an Advanced Reaction from the Harlequin Army List for a Unit that has at least one Model within 12\" of Vaelith (including Vaelith's own Unit), that Advanced Reaction costs no points from their Reaction Allotment. This does not allow a Unit to make more than one Reaction in the same Player Turn."
        },
        {
          "name": "The Endless Encore",
          "text": "The first time in a battle that Vaelith would be Removed as a Casualty, roll a Dice. On a result of 4+, he is not Removed as a Casualty; instead he is removed from the Battlefield and placed in Reserves with 1 Wound remaining. He may enter play from Reserves as normal in a later turn, using the Deep Strike Special Rule even though he does not have it. If he was part of a Unit, the rest of that Unit remains on the Battlefield."
        }
      ],
      "cryptoArkana": false,
      "fixedArkana": null,
      "factionChoice": true,
      "options": [],
      "note": "An original character written for this army list. The Great Harlequin who has led more masques than any living player can remember; he takes the Masque Trait of the army he leads."
    },
