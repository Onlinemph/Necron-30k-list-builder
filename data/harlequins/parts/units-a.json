        "Impossible Form",
        "Twin Blades"
      ],
      "unitRules": [
        {
          "name": "The Lonely Path",
          "text": "The Solitaire walks the Path of Damnation alone, and even other Harlequins keep their distance. A Model with this Special Rule may never join a Unit, and no Model may join its Unit. It has no Masque Trait: it is not affected by any Masque's Special Rules, and it is ignored when checking that every Unit in a Detachment shares one Masque."
        },
        {
          "name": "Blitz",
          "text": "Once per battle, at the start of its Controlling Player's Movement Phase, the Solitaire may Blitz. Until the end of that turn it modifies its Movement Characteristic by +2D6 (roll once when the Blitz is declared) and its Attacks Characteristic by +3."
        },
        {
          "name": "Impossible Form",
          "text": "The Solitaire has the Shrouded (4+) Special Rule, and its Characteristics other than Wounds can never be reduced below their Base Values by enemy Rules or Special Rules."
        },
        {
          "name": "Twin Blades",
          "text": "When the Solitaire makes Melee Attacks, its Controlling Player may split its Attacks between its Harlequin's Kiss and its Harlequin's Caress, declaring how many Attacks are made with each before any Hit Tests are made."
        }
      ],
      "cryptoArkana": false,
      "fixedArkana": null,
      "options": [
        {
          "id": "enigma",
          "text": "May have one item from the Enigmas of the Black Library selected for it.",
          "kind": "one",
          "model": null,
          "replaces": [],
          "choices": [
            {
              "list": "enigmas-of-the-black-library"
            }
          ],
          "max": null,
          "requires": null
        }
      ],
      "note": "A Solitaire has no Masque, so it never picks one and it can sit in any Masque's Detachment."
    },
