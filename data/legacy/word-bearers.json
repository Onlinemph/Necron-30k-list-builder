  "rites": [
    {
      "name": "Unyielding Faith",
      "flavor": "A Legion that believes cannot be convinced to leave the field.",
      "benefits": [
        "Every non-vehicle model gains +1 Willpower and +1 Leadership.",
        "Chaplains and Diabolists gain Litany of Resolve: friendly units within 12\" automatically pass Morale and Pinning checks."
      ],
      "limitations": [
        "At least two Chaplains or Diabolists must be in the army.",
        "No Techmarines, Forge Lords, Thallax, Castellax, Domitar, Thanatar, Vorax or Vultarax."
      ],
      "modifiers": [
        {
          "match": {
            "notUnitType": "Vehicle"
          },
          "text": "Unyielding Faith: +1 WP, +1 LD.",
          "stats": {
            "WP": "+1",
            "LD": "+1"
          }
        },
        {
          "units": [
            "chaplain",
            "chaplain-with-jump-pack",
            "mounted-chaplain",
            "chaplain-in-terminator-armour",
            "diabolist",
            "diabolist-in-terminator-armour",
            "mounted-diabolist"
          ],
          "text": "Unyielding Faith: Litany of Resolve.",
          "addRules": [
            "Litany of Resolve"
          ]
        }
      ],
      "require": [
        {
          "units": [
            "chaplain",
            "chaplain-with-jump-pack",
            "mounted-chaplain",
            "chaplain-in-terminator-armour",
            "diabolist",
            "diabolist-in-terminator-armour",
            "mounted-diabolist"
          ],
          "min": 2,
          "note": "At least two Chaplains or Diabolists lead the faithful."
        }
      ],
      "forbid": [
        {
          "units": [
            "techmarine",
            "forge-lord",
            "mounted-forge-lord",
            "forge-lord-in-terminator-armour",
            "thallax-cohort",
