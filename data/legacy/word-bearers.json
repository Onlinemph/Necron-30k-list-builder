  "rules": [
    {
      "name": "Litany of Resolve",
      "text": "Legacy house rule (Unyielding Faith). While a friendly Word Bearers unit is within 12\" of a model with this rule, it adds +1 to its Leadership and Cool for Morale and Pinning checks."
    },
    {
      "name": "Daemonic Vessels",
      "text": "Legacy house rule (The Possessed Host). A unit with this rule gains Rending (6+) in any Combat in which it made a Charge this turn. It must declare a Charge against the closest enemy unit it can reach whenever it is able to."
    },
    {
      "name": "Descent of the Preachers",
      "text": "Legacy house rule (Sermon from the Sky). A unit with this rule that arrives by Deep Strike gains Fear (1) until the end of the turn it arrives."
    },
    {
      "name": "Tide of Converts",
      "text": "Legacy house rule (The Indoctrinated Tide). A unit with this rule gains Line (1) and, while it has ten or more models, automatically passes Morale checks."
    },
    {
      "name": "Marching Hymn",
      "text": "Legacy house rule. When the unit of a model with this rule Rushes, add 2\" to the distance it moves."
    },
    {
      "name": "Faith-Warded Mind",
      "text": "Legacy house rule. The unit of a model with this rule adds 2 to its Willpower Checks made to resist enemy psychic attacks."
    },
    {
      "name": "Pilgrim's Cry",
      "text": "Legacy house rule. A unit with this rule adds 1 to its Charge rolls. Once per battle it automatically passes one Morale Check."
    },
    {
      "name": "Anointed Hull",
      "text": "Legacy house rule. Once per battle, a vehicle with this rule may ignore one Glancing Hit."
    },
    {
      "name": "Siren Wail",
      "text": "Legacy house rule. Enemy units within 12\" of a vehicle with this rule cannot Rush towards it."
    },
    {
      "name": "Sacrificial Blade",
      "text": "Legacy house rule. When a model with this rule slays an enemy in a Challenge, every friendly unit within 12\" adds 1 to its Cool until the end of the turn."
    }
  ],
