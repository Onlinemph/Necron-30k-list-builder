  "rules": [
    {
      "name": "Litany of Resolve",
      "text": "Legacy house rule (Unyielding Faith). While a friendly Word Bearers unit is within 12\" of a model with this rule, it automatically passes Morale and Pinning checks."
    },
    {
      "name": "Daemonic Vessels",
      "text": "Legacy house rule (The Possessed Host). A unit with this rule gains Rending (6+) in any Combat in which it made a Charge this turn. It must declare a Charge against the closest enemy unit it can reach whenever it is able to."
    },
    {
      "name": "Descent of the Preachers",
      "text": "Legacy house rule (Sermon from the Sky). A unit with this rule that arrives by Deep Strike gains Fear (1) until the end of the turn it arrives."
    },
    {
      "name": "Tide of Converts",
      "text": "Legacy house rule (The Indoctrinated Tide). A unit with this rule gains Line (1) and, while it has ten or more models, automatically passes Morale checks."
    }
  ]
