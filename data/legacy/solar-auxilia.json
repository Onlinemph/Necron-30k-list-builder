  },
  {
   "name": "Veteran Prime",
   "text": "Legacy house rule. A Prime who has marched through three theatres and never lost a standard. The model gains +1 Ballistic Skill and +1 Leadership."
  },
  {
   "name": "Cohort colours",
   "text": "Legacy house rule. The tercio's battle-honours, stitched into a banner that every trooper can see. Every model in the unit gains +1 Leadership and +1 Cool."
  },
  {
   "name": "Charonite bastion-plate",
   "text": "Legacy house rule. Riveted slabs of charonite alloy bolted over an Ogryn's chest and shoulders. The model's Save becomes 3+ if it was worse."
  },
  {
   "name": "Applique plating",
   "text": "Legacy house rule. Spare armour plate welded on in the field. The vehicle gains +1 Hull Point."
  },
  {
   "name": "Siege plating",
   "text": "Legacy house rule. Thick glacis slabs and track skirts for crawling into a prepared line. The vehicle gains +1 Front armour, but loses 2\" of Movement."
  },
  {
   "name": "Fire-control cogitator",
   "text": "Legacy house rule. A cogitator rack that works out the arc before the gun is laid. The vehicle gains +1 Ballistic Skill."
  }
