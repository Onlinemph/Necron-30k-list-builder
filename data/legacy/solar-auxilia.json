 "wargear": [
  {
   "name": "Carapace breastplate",
   "text": "Legacy house rule. Ceramite-laminate plate issued to Primes and officers who have earned it. The model's Save becomes 3+ if it was worse."
  },
  {
   "name": "Bulwark field-cloak",
