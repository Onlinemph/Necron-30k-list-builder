  "rules": [
    {
      "name": "Immaculate Ranks",
      "text": "Legacy house rule (The Flawless Host). A unit with this rule automatically passes Cool Checks while it has not lost a model since the start of the battle."
    },
    {
      "name": "Dirge of Pain",
      "text": "Legacy house rule (Symphony of Slaughter). While within 12\" of a unit with this rule, enemy units suffer -1 to their Cool Checks."
    },
    {
      "name": "Gilded Descent",
      "text": "Legacy house rule (Descent of the Gilded Wings). A unit with this rule gains Deep Strike and may Charge in the turn it arrives from Reserve. At least half of the army's units with this rule (rounded up) must start the battle in Reserve."
    },
    {
      "name": "Composed Volley",
      "text": "Legacy house rule (A Thousand Suns). A unit with this rule gains Precision (6+) on its Shooting attacks."
    }
  ]
}
