  "rites": [
    {
      "name": "The Flawless Host",
      "flavor": "To the Third, a victory with a single flaw in it is a defeat in good clothes.",
      "benefits": [
        "Palatine Blade squads, Phoenix Terminator Squads and Veteran Tactical and Veteran Assault Squads may fill Troops slots and gain Line (1).",
        "Palatine Blade and Phoenix squads gain +1 Weapon Skill.",
        "All those units gain Immaculate Ranks: they automatically pass Cool Checks while at full strength."
      ],
      "limitations": [
        "At least one Palatine Blade squad is required.",
        "No Tactical, Despoiler, Assault, Breacher, Scout or Inductii Squads."
      ],
      "roles": [
        {
          "units": [
            "palatine-blade-squad",
