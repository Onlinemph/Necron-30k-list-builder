  "rules": [
    {
      "name": "Cortex-Locked",
      "text": "Legacy house rule (Cohorts of the Iron Father). A unit with this rule automatically passes Morale Checks and Checks to avoid Tactical Statuses caused by casualties, while an Iron Father is on the table."
    },
    {
      "name": "Unyielding Wall",
      "text": "Legacy house rule (Wall of Black Iron). A unit with this rule gains Feel No Pain (6+) in any turn in which it did not move."
    },
    {
      "name": "Hammerfall",
      "text": "Legacy house rule (The Gorgon's Hammer). On the turn a unit with this rule charges it adds +1 Strength. If it destroys the enemy unit it charged, it may make a free move of up to 3\" afterwards."
    },
    {
      "name": "Linked Targeting",
      "text": "Legacy house rule. When friendly Iron Hands units within 6\" of this model shoot at the same target as the bearer's unit, they add +1 to their Hit Tests against it."
    },
    {
      "name": "Anchored",
      "text": "Legacy house rule. A unit with this rule ignores the effects of Pinning (X) and cannot be moved by effects that push or displace it, but it may not Rush."
    },
    {
      "name": "Servo Grapple",
      "text": "Legacy house rule. At the start of each combat, choose one enemy model in base contact with the bearer. It subtracts 1 from its Weapon Skill for that combat."
    },
    {
      "name": "Slab Plating",
      "text": "Legacy house rule. The AP of Shooting Attacks that hit the front of a vehicle with this rule is reduced by 1, to a minimum of 6."
    },
    {
      "name": "Cogitator Overwatch",
      "text": "Legacy house rule. A model with this rule makes Reaction Shooting at its full Ballistic Skill instead of as a Snap Shot."
    },
    {
      "name": "Plough Through",
      "text": "Legacy house rule. A vehicle with this rule ignores Difficult Terrain. Units it Rams lose 1 Cool until the end of the turn."
    },
    {
      "name": "Warp-Dead Field",
      "text": "Legacy house rule. Enemy psychic powers used within 6\" of this model suffer -1 to their Psychic Check, and enemy Psykers within 6\" of it lose 1 Willpower."
    },
    {
      "name": "Oath of the Clan Remnant",
      "text": "Legacy house rule. Once per battle, a unit with this rule automatically passes a Morale Check it is required to make."
    }
  ],
  "rites": [
    {
      "name": "Cohorts of the Iron Father",
      "flavor": "A Clan-Council that trusts steel and cortex-code over the whims of flesh.",
      "benefits": [
        "Castellax Battle Maniples and Castellax Destructor Maniples may fill Troops slots.",
        "Every Castellax gains +1 Ballistic Skill and Cortex-Locked: it passes Morale Checks automatically while an Iron Father is on the table."
      ],
      "limitations": [
        "An Iron Father (either pattern) must be in the army.",
        "No more than two Tactical or Despoiler Squads in total.",
        "No Librarians or Esoterists, no Assault Squads, and no model with the Antigrav type."
      ],
      "roles": [
        {
          "units": [
            "castellax-battle-maniple",
            "castellax-destructor-maniple"
          ],
          "role": "Troops"
        }
      ],
      "modifiers": [
        {
          "units": [
            "castellax-battle-maniple",
            "castellax-destructor-maniple"
          ],
          "text": "Cohorts of the Iron Father: +1 BS, Cortex-Locked.",
          "stats": {
            "BS": "+1"
          },
          "addRules": [
            "Cortex-Locked"
          ]
        }
      ],
      "require": [
        {
          "units": [
            "iron-father",
            "iron-father-in-artificer-armour"
          ],
          "min": 1,
          "note": "An Iron Father must command the cohorts."
        }
      ],
      "limit": [
        {
          "units": [
            "tactical-squad",
            "despoiler-squad"
          ],
          "max": 2
        }
      ],
      "forbid": [
        {
          "match": {
            "nameIncludes": [
              "Librarian",
              "Esoterist"
            ]
          }
        },
        {
          "units": [
            "assault-squad",
            "veteran-assault-squad"
          ]
        },
        {
          "match": {
            "unitType": "Antigrav"
          }
        }
      ]
    },
    {
      "name": "Wall of Black Iron",
      "flavor": "Nothing in the Legion is built to retreat, and the Immortals least of all.",
      "benefits": [
        "Gorgon Terminator Squads may fill Troops slots.",
        "Medusan Immortals Squads gain Line (1) and Unyielding Wall: Feel No Pain (6+) in any turn they did not move."
      ],
      "limitations": [
        "At least two Medusan Immortals Squads are required.",
        "No Fast Attack units and no Recon units."
      ],
      "roles": [
        {
          "units": [
            "gorgon-terminator-squad"
          ],
          "role": "Troops"
        }
      ],
      "modifiers": [
        {
          "units": [
            "medusan-immortals-squad"
          ],
          "text": "Wall of Black Iron: Line (1), Unyielding Wall.",
          "addRules": [
            "Line (1)",
            "Unyielding Wall"
          ]
        }
      ],
      "require": [
        {
          "units": [
            "medusan-immortals-squad"
          ],
          "min": 2,
          "note": "Bring at least two Medusan Immortals Squads."
        }
      ],
      "forbid": [
        {
          "match": {
            "role": "Fast Attack"
          }
        },
        {
          "match": {
            "role": "Recon"
          }
        }
      ]
    },
    {
      "name": "The Gorgon's Hammer",
      "flavor": "When the clan-lords stop talking, the Gorgons go in.",
      "benefits": [
        "Gorgon Terminator Squads may fill Troops slots and gain Line (1).",
        "They gain Hammerfall: +1 Strength on a turn they charge, and a free 3\" move after destroying the unit they charged."
      ],
      "limitations": [
        "At least two Gorgon Terminator Squads are required.",
        "No Armour units and no Recon units."
      ],
      "roles": [
        {
          "units": [
            "gorgon-terminator-squad"
          ],
          "role": "Troops"
