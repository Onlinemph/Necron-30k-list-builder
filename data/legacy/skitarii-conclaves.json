  "rules": [
    {
      "name": "Rad-Saturation",
      "text": "Legacy house rule (The Vanguard Saturation Cant). The Corpus walks ahead of the line, fouling the ground. An enemy unit within 6\" of a model with this rule has -1 to its Cool and Leadership."
    },
    {
      "name": "Long Watch",
      "text": "Legacy house rule (The Ranger Long Watch). Patient hunters pick their moment. A unit with this rule that did not move in its last Movement phase counts its Shooting Attacks as having Precision (6+), and may be deployed after all other units on its side have been placed."
    },
    {
      "name": "Run Them Down",
      "text": "Legacy house rule (The Sicarian Hunt). The hounds close on a wounded foe. A unit with this rule adds 2 to its Charge roll and gains Outflank."
    },
    {
      "name": "War-Cant Chorus",
      "text": "Legacy house rule (The Armoured War-Cant). The tanks sing as one. A unit with this rule adds 1 to its Ballistic Skill while it is within 6\" of another friendly unit with War-Cant Chorus."
    },
    {
      "name": "Ten Thousand Dead",
      "text": "Legacy house rule (The Bonepicker Tithe). The chaff is counted in tens of thousands and no one counts the losses. A unit with this rule automatically passes Cool, Pinning and Panic Checks while it has five or more models, and it gains Outflank."
    },
    {
      "name": "Waste Cloak",
      "text": "Legacy house rule. The bearer may use Infiltrate (9) when deployed in a wasteland or ruin terrain feature."
    },
    {
      "name": "Rousing Cant",
      "text": "Legacy house rule. The unit automatically passes Pinning checks and adds +1 to its Charge rolls."
    },
    {
      "name": "Dead-Drop",
      "text": "Legacy house rule. Friendly units arriving from Reserves within 6\" of the bearer do not scatter."
    },
    {
      "name": "Rad-Nimbus",
      "text": "Legacy house rule. Enemy units in combat with the bearer suffer -1 Initiative."
    },
    {
      "name": "Hot-Zone Sensing",
