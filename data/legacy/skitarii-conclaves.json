  "wargear": [
    {
      "name": "Sub-dermal plating",
      "text": "Legacy house rule. Armour sheets implanted beneath the skin of a conclave's best. The model's Save becomes 3+ if it was worse."
    },
    {
      "name": "Refractor halo",
      "text": "Legacy house rule. A ring of old-pattern deflector crystals worn around the Marshal's head. The model's Invulnerable Save becomes 4+ if it was worse."
    },
    {
      "name": "Cantor choir",
      "text": "Legacy house rule. Vox-casters and chanting augmetic cantors who broadcast the conclave's war-cant. Every model in the unit gains +1 Leadership and +1 Cool."
    },
    {
      "name": "Stim-pump",
      "text": "Legacy house rule. A reactor-fed injector that spikes the pilgrym's pulse for the charge. On a turn the unit charges, every model in it gains +1 Attack."
    },
    {
      "name": "Cant-coda",
      "text": "Legacy house rule. A firing script uploaded from the conclave's gunnery cant. Every model in the unit gains +1 Ballistic Skill."
    },
    {
      "name": "Cradle of servo-arms",
      "text": "Legacy house rule. A sling of servo-arms and spare plate carried inside the hull. The vehicle gains +1 Hull Point."
    },
    {
      "name": "Waste-hide cloak",
      "text": "Legacy house rule. A cloak of sand-coloured hide dyed with ash and dust. Gives the Ordinatus Waste Cloak and Shrouded (5+)."
    },
    {
      "name": "Rousing-cant standard",
      "text": "Legacy house rule. A rattling standard whose bells chime the conclave's war-cant. Gives the unit Rousing Cant."
    },
    {
      "name": "Dead-drop beacon",
      "text": "Legacy house rule. A pulsing locator the Marshal plants for those still to arrive. Gives the model Dead-Drop."
    },
    {
      "name": "Rad-nimbus furnace",
      "text": "Legacy house rule. A back-mounted reactor that bathes the bearer in killing glare. Gives the model Rad-Nimbus."
    },
    {
      "name": "Geiger-vane mast",
      "text": "Legacy house rule. A spinning sensor mast that tastes the contamination in the air. Gives the vehicle Hot-Zone Sensing."
    },
    {
      "name": "Ablative sand-skirts",
      "text": "Legacy house rule. Sacrificial skirts of plate that crumble under fire. Gives the vehicle +1 Side armour and Shed Plating."
    },
    {
      "name": "Kill-code scroll",
      "text": "Legacy house rule. A strip of scored data-vellum that overrides every restraint in an automaton's core. Gives the model Kill-Code, +1 Weapon Skill and -1 Ballistic Skill."
    }
  ],
