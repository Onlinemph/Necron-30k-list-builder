  "rules": [
    {
      "name": "Silent Hunt",
      "text": "Legacy house rule (Vow of the Silent Hunt). An enemy Psyker within 12\" of a unit with this rule subtracts 1 from its Willpower while it is there."
    },
    {
      "name": "Oblivion Charge",
      "text": "Legacy house rule (The Oblivion Knights Ride). A unit with this rule may declare a Charge on the turn it disembarks from a transport. If an enemy Psyker or Malefic unit is within its charge reach, it must charge one."
    },
    {
      "name": "Incorruptible Engines",
      "text": "Legacy house rule (The Black Ships' Writ). Enemy Psychic powers can't target a model with this rule, and it is unaffected by Corruption and Malefic abilities."
    }
  ]
