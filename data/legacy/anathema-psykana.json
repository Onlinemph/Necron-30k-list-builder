  "rites": [
    {
      "name": "Vow of the Silent Hunt",
      "flavor": "They do not shout. They do not speak. The witch notices only that her prayers have stopped working.",
      "benefits": [
        "Kharon Pattern Acquisitors may fill Troops slots.",
        "Anathema Cadres gain Infiltrate (9) and Silent Hunt: an enemy Psyker within 12\" takes -1 to its Willpower."
      ],
      "limitations": [
        "At least two Anathema Cadres are required.",
        "No Vagus automata."
      ],
      "roles": [
        {
          "units": [
            "kharon-pattern-acquisitor"
          ],
          "role": "Troops"
        }
      ],
      "modifiers": [
        {
          "units": [
            "anathema-cadre"
          ],
          "text": "Vow of the Silent Hunt: Infiltrate (9), Silent Hunt.",
          "addRules": [
            "Infiltrate (9)",
            "Silent Hunt"
          ]
        }
      ],
      "require": [
        {
          "units": [
            "anathema-cadre"
          ],
          "min": 2,
          "note": "At least two Cadres take the vow."
        }
      ],
      "forbid": [
        {
          "match": {
            "trait": "Vagus"
          }
        }
      ]
    },
    {
      "name": "The Oblivion Knights Ride",
      "flavor": "Even the Silent Sisterhood needs someone to carry a sword where the witch-fire cannot reach.",
      "benefits": [
        "Knight-Centuras may fill Troops and Elites slots, gain Line (1) and +1 Attack.",
        "They gain Oblivion Charge: a unit may Charge on the turn it disembarks from a transport."
      ],
      "limitations": [
        "At least two Knight-Centuras are required.",
        "No Anathema Cadres.",
        "A Knight-Centura that can charge an enemy Psyker or Malefic unit must do so."
      ],
      "roles": [
        {
          "units": [
            "knight-centura"
          ],
          "role": "Troops"
        },
        {
          "units": [
            "knight-centura"
          ],
          "role": "Elites"
        }
      ],
      "modifiers": [
        {
          "units": [
            "knight-centura"
          ],
          "text": "The Oblivion Knights Ride: +1 A, Line (1), Oblivion Charge.",
          "stats": {
            "A": "+1"
          },
          "addRules": [
            "Line (1)",
            "Oblivion Charge"
          ]
        }
      ],
      "require": [
        {
          "units": [
            "knight-centura"
          ],
          "min": 2,
          "note": "At least two Oblivion Knights ride."
        }
      ],
      "forbid": [
        {
          "units": [
            "anathema-cadre"
          ]
        }
      ]
    },
    {
      "name": "The Black Ships' Writ",
      "flavor": "When the Sisters cannot be everywhere, the Throne lends them machines that cannot be tempted.",
      "benefits": [
        "Castellax Battle and Destructor Maniples may fill Troops slots and gain Line (1).",
        "They gain Incorruptible Engines: enemy Psychic powers can't target them.",
        "Anathema Cadres gain +1 Leadership."
      ],
      "limitations": [
        "At least two Castellax Maniples are required.",
        "No more than one Anathema Cadre.",
        "No Kharon Pattern Acquisitors."
      ],
      "roles": [
        {
          "units": [
            "castellax-battle-maniple",
