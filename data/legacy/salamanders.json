  "rites": [
    {
      "name": "Forge-Fires of Nocturne",
      "flavor": "The drakes walk in front, and nothing that burns stays standing.",
      "benefits": [
        "Pyroclast and Firedrake Terminator Squads may fill Troops slots.",
        "Pyroclast and Firedrake squads gain Forge-Fire: Shooting Attacks made with their flame (Template) weapons add 1 to their Wound Tests."
      ],
      "limitations": [
        "At least one Pyroclast or Firedrake squad is required.",
        "No Fast Attack or Recon units, and nothing with the Antigrav type."
      ],
      "modifiers": [
        {
          "units": [
            "pyroclast-squad",
            "firedrake-terminator-squad"
          ],
          "text": "Forge-Fires of Nocturne: Forge-Fire.",
          "addRules": [
            "Forge-Fire"
          ]
        }
      ],
      "require": [
        {
          "units": [
            "pyroclast-squad",
            "firedrake-terminator-squad"
          ],
          "min": 1,
          "note": "Bring a Pyroclast or Firedrake squad."
        }
      ],
      "forbid": [
        {
          "match": {
            "roles": [
              "Fast Attack",
              "Recon"
            ]
          }
        },
        {
          "match": {
            "unitType": "Antigrav"
          }
        }
      ],
      "roles": [
        {
          "units": [
            "pyroclast-squad",
            "firedrake-terminator-squad"
          ],
          "role": "Troops"
        }
      ]
    },
    {
      "name": "Shield of the Weak",
      "flavor": "Vulkan taught his sons that a wall is only a wall when someone stands behind it.",
      "benefits": [
        "Sanctifier Squads may fill Troops slots.",
        "Adherents and Sanctifier Squads gain Line (1) and Shield Wall: they automatically pass Morale and Pinning checks while they have not moved this turn."
      ],
      "limitations": [
        "At least one Adherents Squad and one Sanctifier Squad are required.",
        "No Fast Attack, Recon or Lord of War units."
      ],
      "modifiers": [
        {
          "units": [
            "adherents-squad",
            "sanctifier-squad"
          ],
          "text": "Shield of the Weak: Line (1), Shield Wall.",
          "addRules": [
            "Line (1)",
            "Shield Wall"
          ]
        }
      ],
      "require": [
        {
          "units": [
            "adherents-squad"
          ],
          "min": 1,
          "note": "Bring an Adherents Squad."
        },
        {
          "units": [
            "sanctifier-squad"
          ],
          "min": 1,
          "note": "Bring a Sanctifier Squad."
        }
      ],
      "forbid": [
        {
          "match": {
            "roles": [
              "Fast Attack",
              "Recon",
              "Lord of War"
            ]
          }
        }
      ],
      "roles": [
        {
          "units": [
            "sanctifier-squad"
          ],
          "role": "Troops"
        }
      ]
    },
    {
      "name": "The Armoured Anvil",
      "flavor": "On Nocturne even the tanks are tempered twice.",
      "benefits": [
        "Armour and Transport vehicles (other than Flyers) gain +1 Hull Point.",
        "Armour units gain Anvil Advance: Line (1), and they may make Shooting Attacks after Rushing in the first battle turn."
      ],
      "limitations": [
        "At least two Armour units are required, and no more than three Infantry units in Troops slots.",
        "No Drop Pods, Dreadclaws or Kharybdis, and nothing with the Antigrav type."
      ],
      "modifiers": [
        {
          "match": {
            "roles": [
              "Armour",
              "Transport"
            ],
            "unitType": "Vehicle",
            "notUnitType": "Flyer"
          },
          "text": "The Armoured Anvil: +1 HP.",
          "stats": {
            "HP": "+1"
          }
        },
        {
          "match": {
            "role": "Armour",
            "unitType": "Vehicle"
          },
          "text": "The Armoured Anvil: Line (1), Anvil Advance.",
          "addRules": [
            "Line (1)",
            "Anvil Advance"
          ]
        }
      ],
      "require": [
        {
          "match": {
            "role": "Armour"
          },
          "min": 2,
          "note": "The Anvil needs at least two Armour units."
        }
      ],
      "forbid": [
        {
          "match": {
            "unitType": "Antigrav"
          }
        },
        {
          "units": [
            "drop-pod",
            "dreadnought-drop-pod",
            "deathstorm-drop-pod",
            "dreadclaw-drop-pod",
            "kharybdis-assault-claw"
          ]
        }
      ],
      "limit": [
        {
          "match": {
            "role": "Troops",
            "notUnitType": "Vehicle"
          },
          "max": 3,
          "note": "At most three Infantry units in Troops slots."
        }
      ]
    },
    {
      "name": "Procession of the Honoured",
      "flavor": "The entombed brothers are carried to war so that none of them is ever left behind.",
      "benefits": [
        "Contemptor and Castra Ferrum Dreadnoughts may fill Troops slots.",
        "They gain Line (1) and Unbowed Elders: once per battle each may treat one Hit Test as a roll of 6."
      ],
      "limitations": [
        "At least two Dreadnoughts are required.",
        "No Terminator squads, and no Heavy Assault units."
      ],
      "modifiers": [
        {
          "units": [
            "contemptor-dreadnought",
            "castra-ferrum-dreadnought"
          ],
          "text": "Procession of the Honoured: Line (1), Unbowed Elders.",
          "addRules": [
            "Line (1)",
            "Unbowed Elders"
          ]
        }
      ],
      "require": [
        {
          "units": [
            "contemptor-dreadnought",
            "castra-ferrum-dreadnought",
            "leviathan-dreadnought",
            "deredeo-dreadnought",
            "saturnine-dreadnought",
            "cassian-dracos-reborn"
          ],
          "min": 2,
          "note": "At least two Dreadnoughts march in the procession."
        }
      ],
      "forbid": [
        {
          "match": {
            "nameIncludes": [
              "Terminator",
              "Firedrake"
            ]
          }
        },
        {
          "match": {
            "role": "Heavy Assault"
          }
        }
      ],
      "roles": [
        {
          "units": [
            "contemptor-dreadnought",
            "castra-ferrum-dreadnought"
          ],
          "role": "Troops"
        }
      ]
    }
  ],
  "rules": [
    {
      "name": "Forge-Fire",
      "text": "Legacy house rule (Forge-Fires of Nocturne). A unit with this rule adds 1 to the Wound Tests of Shooting Attacks made with flame (Template) weapons."
    },
    {
      "name": "Shield Wall",
      "text": "Legacy house rule (Shield of the Weak). A unit with this rule automatically passes Morale and Pinning checks if it has not moved in its own most recent Movement phase."
    },
    {
      "name": "Anvil Advance",
      "text": "Legacy house rule (The Armoured Anvil). A model with this rule gains Line (1), and on the first battle turn it may Rush and still make a Shooting Attack."
    },
    {
      "name": "Unbowed Elders",
      "text": "Legacy house rule (Procession of the Honoured). Once per battle, a model with this rule may treat one Hit Test as if it had rolled a 6."
    },
    {
      "name": "Fuel Reserve",
      "text": "Legacy house rule. The unit of a model with this rule ignores the first natural 1 each battle for Overstoked Promethium, and its flame (Template) weapons add 1 to their Wound Tests against units that are Aflame."
    },
    {
      "name": "Drake-Hide Mantle",
      "text": "Legacy house rule. Damage from Template weapons and weapons with Aflame (X) against a model with this rule is reduced by 1 (to a minimum of 1)."
    },
    {
      "name": "Pavise Wall",
      "text": "Legacy house rule. A unit with this rule that did not move in its last Movement phase gains Shrouded (5+) against Shooting Attacks."
    },
    {
      "name": "Field Mending",
      "text": "Legacy house rule. Once per battle, at the start of its controller's turn, a vehicle with this rule may remove one Tactical Status or restore one lost Hull Point."
    },
    {
      "name": "Hearth-ram Plough",
      "text": "Legacy house rule. A vehicle with this rule ignores movement penalties from barricades and rubble, and adds 1 to the Hits it inflicts when it moves through enemy units."
    },
    {
      "name": "Hearthfire Anchor",
      "text": "Legacy house rule. The unit of a model with this rule counts as having two additional models when Controlling an Objective, and adds 1 to Cool Checks while it does."
    }
  ],
  "armyRules": [
    {
      "name": "Stoic Defenders",
      "match": {
        "roles": [
          "Troops",
          "Elites",
          "Support",
          "Heavy Assault"
        ],
        "notUnitType": "Vehicle"
      },
      "optionalUnits": true,
      "stats": {
        "CL": "+1"
      },
      "condition": "if the unit did not move in its last Movement phase",
      "text": "Legacy house rule. Salamanders do not give ground. A unit with this rule adds 1 to its Cool if it did not move in its last Movement phase. The price is a slow start: it may not Rush on the first battle turn."
    },
    {
      "name": "Nocturne's Mercy",
      "match": {
        "roles": [
          "High Command",
          "Command"
        ],
        "notUnitType": "Vehicle"
      },
