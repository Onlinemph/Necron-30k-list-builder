  "wargear": [
    {
      "name": "Prospero sigil-charm",
      "text": "Legacy house rule. A tiny glyph-etched amulet, renewed every dawn by a cabal scribe. The model has a 5+ Invulnerable Save if it was worse."
    },
    {
      "name": "Fate-glass",
      "text": "Legacy house rule. A lens of cut crystal through which a sorcerer glimpses a few seconds of the next minute. The model gains +1 Willpower and +1 Intelligence."
    },
    {
      "name": "Warp-touched banner",
      "text": "Legacy house rule. A standard whose threads shift colour when no one is looking. Every model in the unit gains +1 Willpower and +1 Intelligence."
    },
    {
      "name": "Warding-sigil engraving",
      "text": "Legacy house rule. Rune-lines cut into the hull by a Prosperine artisan. The model has a 4+ Invulnerable Save if it was worse."
    },
    {
      "name": "Aegis of Utterances",
      "text": "Legacy house rule. A tablet of closely-written wards worn at the breast. Gives the model Spell-Ward."
    },
    {
      "name": "Cabal obelisk-key",
      "text": "Legacy house rule. A small black prism that fixes a patch of ground in the cabal's foresight. Gives the model Sorcerous Claim."
    },
    {
      "name": "Numerologist's slate",
      "text": "Legacy house rule. A wax slate scored with firing solutions, carried by the squad's sergeant. Gives the model Calculated Volley."
    },
    {
      "name": "Banner of Shifting Hues",
      "text": "Legacy house rule. A standard whose colours crawl and never settle. Every model in the unit gains Dizzying Hues."
    },
    {
      "name": "Mirage lacquer",
      "text": "Legacy house rule. A prismatic coating laid over hull plates by Prosperine artisans. The vehicle gains Mirage Lacquer."
    },
    {
      "name": "Blade-song glyph",
      "text": "Legacy house rule. A resonant rune cut into the guard of a blademaster's sword. Gives the model Blade-song Rhythm."
    }
  ],
