  "wargear": [
    {
      "name": "Deathwing oath-standard",
      "text": "Legacy house rule. A tattered banner bearing the names of the sworn, carried by the one brother who will never be asked what it is for. Every model in the unit gains +1 Willpower and +1 Leadership."
    },
    {
      "name": "Ravenwing veil-field",
      "text": "Legacy house rule. A dispersal screen that smears the heat-shadow of riders and scouts across the horizon. The unit gains Shrouded (6+)."
    },
    {
      "name": "Penitent's rosarius",
      "text": "Legacy house rule. A chained reliquary of the Order, said to turn aside what it cannot explain. Gives the bearer Warding Rosarius."
    },
    {
      "name": "Ravenwing locator-beacon",
      "text": "Legacy house rule. A strobing transponder that tells the whole wing where the quarry is running. Gives the vehicle Hunter's Mark."
    },
    {
      "name": "Interrogator's brand",
      "text": "Legacy house rule. A branding iron and a very patient voice. Gives the bearer's unit Confession Drive."
    },
    {
      "name": "Standard of the Long Watch",
      "text": "Legacy house rule. A black banner that has never been furled while its bearer lives. Gives the unit Long Watch."
    },
    {
      "name": "Reliquary plate",
      "text": "Legacy house rule. Armour inlaid with the sealed remains of a fallen brother. Gives the bearer's unit Reliquary Ward."
    },
    {
      "name": "Ordnance auto-loader",
      "text": "Legacy house rule. A rebuilt shell-feed that trades the engine's safety for speed. Gives the vehicle Overcharged Feed."
    }
  ],
  "rules": [
    {
      "name": "Deathwing Assault",
      "text": "Legacy house rule (Oath of the Deathwing). A unit with this rule gains Deep Strike. At least half of the army's units with this rule (rounded up) must start the battle in Reserve."
    },
    {
      "name": "Wings of Night",
      "text": "Legacy house rule (The Wings Unbroken). A unit with this rule gains Outflank. It may not make a Charge in the first battle turn."
    },
    {
      "name": "Silent Hunt",
      "text": "Legacy house rule (Secrets Kept in Silence). A unit with this rule gains Infiltrate (6), but may not make a Charge in the first battle turn."
    },
    {
      "name": "Inner Circle Mandate",
      "text": "Legacy house rule (The Inner Circle Convenes). A unit with this rule adds +1 to its Cool for Cool Checks, and every other friendly Dark Angels unit within 6\" adds +1 to its Leadership."
    },
    {
      "name": "Warding Rosarius",
      "text": "Legacy house rule. The bearer adds +2 to Willpower Checks forced by enemy Psychic powers and has Feel No Pain (5+) against Wounds caused by Psychic powers."
    },
    {
      "name": "Hunter's Mark",
      "text": "Legacy house rule. Once per battle, in the Shooting phase, choose one enemy unit within 24\". Friendly Dark Angels units add +1 to Ballistic Skill against it until the end of the phase."
    },
    {
      "name": "Confession Drive",
      "text": "Legacy house rule. Enemy units in combat with the bearer's unit suffer -1 Leadership for Combat Checks."
    },
    {
      "name": "Long Watch",
      "text": "Legacy house rule. A unit with this rule that did not move in its last Movement phase counts as having two additional models for the purpose of holding an objective."
    },
    {
      "name": "Reliquary Ward",
      "text": "Legacy house rule. The bearer's unit has Feel No Pain (6+) while the bearer is alive. If the bearer is removed, models in the unit suffer -1 Cool for the rest of the battle."
    },
    {
      "name": "Overcharged Feed",
      "text": "Legacy house rule. Once per battle, one weapon on this vehicle may double its Firepower for one Shooting Attack. The vehicle cannot make Shooting Attacks in its next turn."
    }
  ],
