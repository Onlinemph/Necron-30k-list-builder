  "rules": [
    {
      "name": "Deathwing Assault",
      "text": "Legacy house rule (Oath of the Deathwing). A unit with this rule gains Deep Strike. At least half of the army's units with this rule (rounded up) must start the battle in Reserve."
    },
    {
      "name": "Wings of Night",
      "text": "Legacy house rule (The Wings Unbroken). A unit with this rule gains Outflank. It may not make a Charge in the first battle turn."
    },
    {
      "name": "Silent Hunt",
      "text": "Legacy house rule (Secrets Kept in Silence). A unit with this rule gains Infiltrate (6), but may not make a Charge in the first battle turn."
    },
    {
      "name": "Inner Circle Mandate",
      "text": "Legacy house rule (The Inner Circle Convenes). A unit with this rule may re-roll failed Cool Checks, and every other friendly Dark Angels unit within 6\" adds +1 to its Leadership."
    }
  ]
