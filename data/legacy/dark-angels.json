  "rites": [
    {
      "name": "Oath of the Deathwing",
      "flavor": "The first company keeps its secrets in plate that no blade has yet answered.",
      "benefits": [
        "Cataphractii, Tartaros and Saturnine Terminator Squads may fill Troops slots and gain Line (1).",
        "Every Terminator squad and Deathwing Companion detachment gains +1 Willpower.",
        "Terminator squads gain Deathwing Assault: Deep Strike."
      ],
      "limitations": [
        "At least two Terminator squads are required.",
        "No Antigrav or Fast Attack units, and at most one Armour unit.",
        "At least half of the army's Terminator squads (rounded up) must start in Reserve."
      ],
      "roles": [
        {
          "units": [
            "cataphractii-terminator-squad",
            "tartaros-terminator-squad",
            "saturnine-terminator-squad"
          ],
          "role": "Troops"
        }
      ],
      "require": [
        {
          "units": [
            "cataphractii-terminator-squad",
            "tartaros-terminator-squad",
            "saturnine-terminator-squad"
          ],
          "min": 2,
          "note": "Bring at least two Terminator squads."
        }
      ],
      "forbid": [
        {
          "match": {
            "unitType": "Antigrav"
          }
        },
        {
          "match": {
            "role": "Fast Attack"
          }
        }
      ],
      "limit": [
        {
          "match": {
            "role": "Armour"
          },
          "max": 1,
          "note": "At most one Armour unit."
        }
      ],
      "modifiers": [
        {
          "units": [
            "cataphractii-terminator-squad",
            "tartaros-terminator-squad",
            "saturnine-terminator-squad"
          ],
          "text": "Oath of the Deathwing: Deathwing Assault, Deep Strike, Line (1).",
          "addRules": [
            "Deathwing Assault",
            "Deep Strike",
            "Line (1)"
          ]
        },
        {
          "units": [
            "cataphractii-terminator-squad",
            "tartaros-terminator-squad",
            "saturnine-terminator-squad",
            "deathwing-companion-detachment",
            "cataphractii-terminator-deathwing-companions",
            "tartaros-terminator-deathwing-companions"
          ],
          "text": "Oath of the Deathwing: +1 WP.",
          "stats": {
            "WP": "+1"
          }
        }
      ]
    },
    {
