  "rites": [
    {
      "name": "Oath of the Deathwing",
      "flavor": "The first company keeps its secrets in plate that no blade has yet answered.",
      "text": "Cataphractii, Tartaros and Saturnine Terminator Squads may fill Troops slots and gain Line (1). Every Terminator squad and Deathwing Companion detachment gains +1 Willpower. The Deathwing marches alone: no Antigrav units, no Fast Attack units, and no more than one Armour unit. At least two Terminator squads are required.",
      "roles": [ { "units": ["cataphractii-terminator-squad", "tartaros-terminator-squad", "saturnine-terminator-squad"], "role": "Troops" } ],
      "modifiers": [
        { "units": ["cataphractii-terminator-squad", "tartaros-terminator-squad", "saturnine-terminator-squad"], "text": "Oath of the Deathwing: Line (1).", "addRules": ["Line (1)"] },
        { "units": ["cataphractii-terminator-squad", "tartaros-terminator-squad", "saturnine-terminator-squad", "deathwing-companion-detachment", "cataphractii-terminator-deathwing-companions", "tartaros-terminator-deathwing-companions"], "text": "Oath of the Deathwing: +1 WP.", "stats": { "WP": "+1" } }
      ],
      "require": [ { "units": ["cataphractii-terminator-squad", "tartaros-terminator-squad", "saturnine-terminator-squad"], "min": 2, "note": "Bring at least two Terminator squads." } ],
      "forbid": [ { "match": { "unitType": "Antigrav" } }, { "match": { "role": "Fast Attack" } } ],
      "limit": [ { "match": { "role": "Armour" }, "max": 1, "note": "At most one Armour unit." } ]
    },
    {
      "name": "The Wings Unbroken",
      "flavor": "Black-armoured riders ahead of the Host, and no one asks where they ride to.",
      "text": "Outrider Squadrons, Scimitar Jetbike Squadrons and Land Speeder Squadrons may fill Troops slots and gain Line (1). Every Cavalry unit gains Fast (1). The Wings leave the heavy iron behind: no Heavy Assault, Armour, Heavy Transport or War Engine units. At least two Outrider or Scimitar squadrons are required.",
      "roles": [ { "units": ["outrider-squadron", "scimitar-jetbike-squadron", "land-speeder-squadron"], "role": "Troops" } ],
      "modifiers": [
        { "units": ["outrider-squadron", "scimitar-jetbike-squadron", "land-speeder-squadron"], "text": "The Wings Unbroken: Line (1).", "addRules": ["Line (1)"] },
        { "match": { "unitType": "Cavalry" }, "text": "The Wings Unbroken: Fast (1).", "addRules": ["Fast (1)"] }
      ],
      "require": [ { "units": ["outrider-squadron", "scimitar-jetbike-squadron"], "min": 2, "note": "Bring at least two Outrider or Scimitar squadrons." } ],
      "forbid": [ { "match": { "roles": ["Heavy Assault", "Armour", "Heavy Transport", "War Engine"] } } ]
    },
    {
      "name": "Secrets Kept in Silence",
      "flavor": "What the hunters find, they never report. What they were hunting, they never name.",
      "text": "Seeker Squads, Scout Squads and Firewing Enigmatus Cabals may fill Troops slots. They gain +1 Ballistic Skill and Shrouded (6+). The hunt cannot be loud: no Lord of War, Armour, Heavy Transport or War Engine units. At least one Seeker Squad is required.",
      "roles": [ { "units": ["seeker-squad", "scout-squad", "firewing-enigmatus-cabal"], "role": "Troops" } ],
      "modifiers": [ { "units": ["seeker-squad", "scout-squad", "firewing-enigmatus-cabal"], "text": "Secrets Kept in Silence: +1 BS, Shrouded (6+).", "stats": { "BS": "+1" }, "addRules": ["Shrouded (6+)"] } ],
      "require": [ { "units": ["seeker-squad"], "min": 1, "note": "Bring at least one Seeker Squad." } ],
      "forbid": [ { "match": { "roles": ["Lord of War", "Armour", "Heavy Transport", "War Engine"] } } ]
    },
    {
      "name": "The Inner Circle Convenes",
      "flavor": "When the Order takes the field, nobody else is given the honour of holding it.",
      "text": "Inner Circle Knights squads may fill Troops slots, cost 25 points less and gain Line (1) and +1 Leadership. No rank and file stand beside them: no Tactical, Despoiler, Assault, Breacher or Inductii Squads. At least two Inner Circle Knights squads are required.",
      "roles": [ { "units": ["inner-circle-knights-cenobium", "inner-circle-knights-cenobium-order-of-the-broken-claws"], "role": "Troops" } ],
      "points": [ { "units": ["inner-circle-knights-cenobium", "inner-circle-knights-cenobium-order-of-the-broken-claws"], "delta": -25 } ],
      "modifiers": [ { "units": ["inner-circle-knights-cenobium", "inner-circle-knights-cenobium-order-of-the-broken-claws"], "text": "The Inner Circle Convenes: Line (1), +1 LD.", "stats": { "LD": "+1" }, "addRules": ["Line (1)"] } ],
      "require": [ { "units": ["inner-circle-knights-cenobium", "inner-circle-knights-cenobium-order-of-the-broken-claws"], "min": 2, "note": "Bring at least two Inner Circle Knights squads." } ],
      "forbid": [ { "units": ["tactical-squad", "despoiler-squad", "assault-squad", "breacher-squad", "inductii-squad"] } ]
    }
