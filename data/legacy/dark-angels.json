{
  "armyRules": [
    {
      "name": "Lock-Step of the Deathwing",
      "text": "Legacy house rule. A Terminator unit with this rule ignores the Pinned Status while within 6\" of another friendly Dark Angels Terminator unit, but cannot Rush on a turn it arrives by Deep Strike.",
      "match": {
        "nameIncludes": [
          "Terminator",
          "Companion",
          "Inner Circle",
          "Knights Cenobium"
        ]
      },
      "optionalUnits": true
    },
    {
      "name": "Ravenwing Strike and Fade",
      "text": "Legacy house rule. After making a Shooting Attack, a unit with this rule that did not Rush may make a free 3\" move directly away from the nearest enemy unit. If it does, it cannot declare a Charge that turn.",
      "units": [
        "outrider-squadron",
        "scimitar-jetbike-squadron",
        "seeker-squad",
        "land-speeder-squadron",
        "javelin-speeder-squadron"
      ],
      "optionalUnits": true
    },
    {
      "name": "The Guilty Secret",
      "text": "Legacy house rule. A Character with this rule is driven by a secret it will not share. It gains +1 Willpower and +1 Intelligence, but suffers -1 Cool.",
      "match": {
        "roles": [
          "Command",
          "High Command",
          "Warlord"
        ],
        "notUnitType": "Vehicle"
      },
      "stats": {
        "WP": "+1",
